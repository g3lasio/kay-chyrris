# Authentication Bypass (Development Only)
# Set to true to bypass authentication, false or remove to enable auth
VITE_DISABLE_AUTH=false

# Database Configuration
DATABASE_URL=postgresql://user:password@host:port/database
OWLFENC_DATABASE_URL=postgresql://user:password@host:port/owlfenc_database
LEADPRIME_DATABASE_URL=postgresql://user:password@host:port/leadprime_database

# Firebase Configuration (if needed)
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_CLIENT_EMAIL=your_client_email
# FIREBASE_PRIVATE_KEY=your_private_key

# Stripe Configuration (if needed)
# STRIPE_SECRET_KEY=your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=your_webhook_secret

# File storage — Cloudflare R2 (S3-compatible). Used for partner documents.
# Set these in Railway. The bucket already exists in Cloudflare: leadprime-documents
# R2_ACCOUNT_ID=your_cloudflare_account_id          # or set R2_ENDPOINT directly
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=your_r2_access_key_id            # R2 API token (Object Read & Write)
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET=leadprime-documents                     # default if unset
# Aliases also accepted: CLOUDFLARE_R2_* / S3_* / AWS_* (access key + secret).

# Partner Referral Portal (partners.chyrris.com)
# RESEND_API_KEY=your_resend_api_key            # OTP + invitation emails (NEVER commit the real key)
# PARTNER_EMAIL_FROM="LeadPrime <no-reply@chyrris.com>"  # must be a Resend-verified domain
# PARTNER_PORTAL_HOST=partners.chyrris.com      # hostname that serves the partner portal
# PARTNER_PORTAL_URL=https://partners.chyrris.com
# REFERRAL_SIGNUP_URL=https://leadprime.chyrris.com/signup
# REFERRAL_WEBHOOK_SECRET=shared_secret_for_attribute_endpoint  # REQUIRED to enable POST /api/referrals/attribute (fail-closed: endpoint is 503 without it)
# REFERRAL_SHORT_LINK_BASE=https://leadprime.chyrris.com        # base for the pretty short links shown in the portal (leadprime.chyrris.com/r/CODE); the /r/CODE redirect lives in the LeadPrime app, not Kai
# LEADPRIME_LANDING_URL=https://leadprime.chyrris.com           # shown to partners as a shareable link (admin can override in the portal settings)
# LEADPRIME_PRODUCTION_URL=https://app.leadprime.chyrris.com
# PARTNER_INVITATION_MODE=auto                                  # 'auto' (send immediately) or 'approval' (admin approves before send)
