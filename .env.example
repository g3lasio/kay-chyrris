# Authentication Bypass (Development Only)
# Set to true to bypass authentication, false or remove to enable auth
VITE_DISABLE_AUTH=false

# Database Configuration
DATABASE_URL=postgresql://user:password@host:port/database
OWLFENC_DATABASE_URL=postgresql://user:password@host:port/owlfenc_database
LEADPRIME_DATABASE_URL=postgresql://user:password@host:port/leadprime_database

# Firebase Configuration (if needed)
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_CLIENT_EMAIL=your_client_email
# FIREBASE_PRIVATE_KEY=your_private_key

# Stripe Configuration (if needed)
# STRIPE_SECRET_KEY=your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=your_webhook_secret

# Partner Referral Portal (partners.chyrris.com)
# RESEND_API_KEY=your_resend_api_key            # OTP + invitation emails (NEVER commit the real key)
# PARTNER_EMAIL_FROM="LeadPrime <no-reply@chyrris.com>"  # must be a Resend-verified domain
# PARTNER_PORTAL_HOST=partners.chyrris.com      # hostname that serves the partner portal
# PARTNER_PORTAL_URL=https://partners.chyrris.com
# REFERRAL_SIGNUP_URL=https://leadprime.chyrris.com/signup
# REFERRAL_WEBHOOK_SECRET=shared_secret_for_attribute_endpoint  # optional but recommended
